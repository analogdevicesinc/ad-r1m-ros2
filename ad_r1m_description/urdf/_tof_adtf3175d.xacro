<?xml version="1.0"?>
<!--
  ADTF3175D ToF Camera

  Simulation vs Real Hardware differences:
    - depth_image: 32FC1 in meters (real: 16UC1 in mm)
    - point_cloud: XYZRGB fields (real: XYZ only)
    - optical_frame: sim uses -pi/2 (Gazebo), real uses pi/2 (driver flips image)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="tof_adtf3175d" params="prefix parent use_sim:=false *origin">

    <!-- Optical frame rotation differs: real driver flips image internally -->
    <xacro:property name="optical_sign" value="${-1 if use_sim else 1}"/>

    <joint name="cam1_adtf31xx_joint" type="fixed">
        <parent link="${parent}"/>
        <child link="${prefix}cam1_adtf31xx"/>
        <xacro:insert_block name="origin" />
    </joint>

    <link name="${prefix}cam1_adtf31xx">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.125"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
        </inertial>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.065 0.075 0.05"/>
            </geometry>
        </collision>

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.065 0.075 0.05"/>
            </geometry>
            <material name="black"/>
        </visual>
    </link>

    <joint name="cam1_adtf31xx_optical_joint" type="fixed">
        <parent link="${prefix}cam1_adtf31xx"/>
        <child link="${prefix}cam1_adtf31xx_optical"/>
        <origin xyz="0 0 0" rpy="${optical_sign * pi/2} 0 ${optical_sign * pi/2}"/>
    </joint>
    <link name="${prefix}cam1_adtf31xx_optical"></link>

    <joint name="cam1_scan_joint" type="fixed">
        <parent link="${prefix}cam1_adtf31xx"/>
        <child link="${prefix}cam1_scan"/>
        <origin xyz="0 0 0" rpy="${pi} 0 0"/>
    </joint>
    <link name="${prefix}cam1_scan"></link>

    <gazebo reference="${prefix}cam1_adtf31xx">
        <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
        </material>

        <!-- 75deg FOV, 512x512, 0.3-5.0m range -->
        <sensor name="cam1_depth" type="depth_camera">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <topic>cam1</topic>
            <camera>
                <horizontal_fov>1.309</horizontal_fov>
                <image>
                    <width>512</width>
                    <height>512</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.3</near>
                    <far>5.0</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.005</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>

</xacro:macro>
</robot>
