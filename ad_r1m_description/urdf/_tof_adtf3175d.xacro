<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:macro name="tof_adtf3175d" params="prefix parent *origin">

    <joint name="cam1_adtf31xx_joint" type="fixed">
        <parent link="${parent}"/>
        <child link="${prefix}cam1_adtf31xx"/>
        <xacro:insert_block name="origin" />
    </joint>

    <link name="${prefix}cam1_adtf31xx">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.125"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
        </inertial>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.065 0.075 0.05"/>
            </geometry>
        </collision>

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.065 0.075 0.05"/>
            </geometry>
            <material name="black"/>
        </visual>
    </link>


    <joint name="cam1_adtf31xx_optical_joint" type="fixed">
        <parent link="${prefix}cam1_adtf31xx"/>
        <child link="${prefix}cam1_adtf31xx_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="${prefix}cam1_adtf31xx_optical"></link>

    <joint name="cam1_scan_joint" type="fixed">
	    <parent link="${prefix}cam1_adtf31xx"/>
	    <child link="${prefix}cam1_scan"/>
		<origin xyz="0 0 0" rpy="${pi} 0 0" />
	</joint>
	<link name="${prefix}cam1_scan"></link>


    <gazebo reference="${prefix}cam1_adtf31xx">
        <material>Gazebo/Black</material>

        <!-- ADTF3175D ToF Camera - 75deg FOV, 512x512, 0.3-5.0m range -->
        <sensor name="cam1_depth" type="depth">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <camera>
                <horizontal_fov>1.309</horizontal_fov>
                <image>
                    <width>512</width>
                    <height>512</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.3</near>
                    <far>5.0</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.005</stddev>
                </noise>
            </camera>

            <plugin name="depth_camera_controller" filename="libgazebo_ros_camera.so">
                <camera_name>cam1</camera_name>
                <frame_name>${prefix}cam1_adtf31xx_optical</frame_name>
                <min_depth>0.1</min_depth>
                <max_depth>10.0</max_depth>
                <ros>
                    <remapping>cam1/image_raw:=cam1/ab_image</remapping>
                    <remapping>cam1/depth/image_raw:=cam1/depth_image</remapping>
                    <remapping>cam1/points:=cam1/point_cloud</remapping>
                </ros>
            </plugin>
        </sensor>
    </gazebo>

</xacro:macro>
</robot>
