<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

<!-- Simulated 2D laser scan - mimics depthimage_to_laserscan output.
     Reuses cam1_scan frame from _tof_adtf3175d.xacro.
     75deg FOV, 0.3-5.0m range -->
<xacro:macro name="lidar" params="prefix parent *origin">

    <gazebo reference="${prefix}cam1_scan">

        <sensor name="laser" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <visualize>false</visualize>
            <update_rate>30</update_rate>
            <topic>scan</topic>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>512</samples>
                        <min_angle>-0.6545</min_angle>
                        <max_angle>0.6545</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.3</min>
                    <max>5.0</max>
                </range>
            </lidar>
        </sensor>
    </gazebo>

</xacro:macro>
</robot>
