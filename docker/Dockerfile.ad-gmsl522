FROM nvcr.io/nvidia/l4t-jetpack:r35.2.1

ENV DEBIAN_FRONTEND=noninteractive

# Install OpenCV build dependencies
RUN apt-get update && apt-get install -y \
    build-essential cmake git pkg-config \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
    libgtk-3-dev libavcodec-dev libavformat-dev libswscale-dev \
    libv4l-dev libxvidcore-dev libx264-dev \
    libjpeg-dev libpng-dev libtiff-dev \
    libatlas-base-dev gfortran \
    python3-dev python3-numpy python3-pip \
    libhdf5-serial-dev libwebp-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone OpenCV 4.13 + contrib
RUN cd /tmp && git clone --depth 1 --branch 4.13.0 https://github.com/opencv/opencv.git && git clone --depth 1 --branch 4.13.0 https://github.com/opencv/opencv_contrib.git

# Build OpenCV with CUDA + GStreamer
RUN cd /tmp/opencv && mkdir build && cd build && \
    cmake -D CMAKE_BUILD_TYPE=RELEASE \
          -D CMAKE_INSTALL_PREFIX=/usr/local \
          -D OPENCV_EXTRA_MODULES_PATH=/tmp/opencv_contrib/modules \
          -D WITH_CUDA=ON \
          -D CUDA_ARCH_BIN=7.2 \
          -D WITH_GSTREAMER=ON \
          -D WITH_LIBV4L=ON \
          -D BUILD_opencv_python3=ON \
          -D BUILD_TESTS=OFF \
          -D BUILD_EXAMPLES=OFF \
          -D BUILD_opencv_java=OFF \
          -D OPENCV_GENERATE_PKGCONFIG=ON \
          .. && \
    make -j$(nproc) && \
    apt-get remove -y libopencv* python3-opencv || true && \
    make install && ldconfig && \
    rm -rf /usr/lib/python3.8/dist-packages/cv2 && \
    ln -s /usr/local/lib/python3.8/site-packages/cv2 /usr/lib/python3.8/dist-packages/cv2 && \
    rm -rf /tmp/opencv /tmp/opencv_contrib

# Upgrade pip and install ultralytics (without polars which requires Python 3.9+)
RUN pip3 install --upgrade pip
RUN pip3 install "ultralytics<8.3" && \
    pip3 uninstall -y opencv-python || true && \
    rm -rf /usr/local/lib/python3.8/dist-packages/cv2 && \
    ln -s /usr/local/lib/python3.8/site-packages/cv2 /usr/local/lib/python3.8/dist-packages/cv2

# Install pytorch, torchvision & dependencies
RUN pip uninstall -y torch torchvision || true && \
    apt-get update && apt-get install -y python3-pip libopenblas-base libopenmpi-dev libomp-dev \
    libjpeg-dev zlib1g-dev libpython3-dev libopenblas-dev libavcodec-dev libavformat-dev libswscale-dev && \
    rm -rf /var/lib/apt/lists/*
RUN cd /tmp && \
    wget https://developer.download.nvidia.cn/compute/redist/jp/v512/pytorch/torch-2.1.0a0+41361538.nv23.06-cp38-cp38-linux_aarch64.whl -O torch-2.1.0a0+41361538.nv23.06-cp38-cp38-linux_aarch64.whl && \
    yes | pip3 install 'Cython<3' && \
    yes | pip3 install numpy torch-2.1.0a0+41361538.nv23.06-cp38-cp38-linux_aarch64.whl && \
    yes | pip3 install --upgrade typing_extensions && \
    rm -f /tmp/torch-*.whl

# Build torchvision from source with CUDA for Xavier (sm_72)
RUN git clone --branch v0.16.1 https://github.com/pytorch/vision /tmp/torchvision && \
    cd /tmp/torchvision && \
    export BUILD_VERSION=0.16.1 && \
    export CUDA_HOME=/usr/local/cuda && \
    export FORCE_CUDA=1 && \
    export TORCH_CUDA_ARCH_LIST="7.2" && \
    python3 setup.py install && \
    cd / && rm -rf /tmp/torchvision

RUN yes | pip3 install numpy==1.23.5

RUN apt-get update && apt-get install -y v4l-utils && rm -rf /var/lib/apt/lists/*

# Install pixi
RUN wget -qO- https://pixi.sh/install.sh | sh && \
    ln -s /root/.pixi/bin/pixi /usr/local/bin/pixi

# Setup workspace and copy perception packageexi
RUN mkdir -p /ros2_ws/src
COPY ad_r1m_perception_video /ros2_ws/src/ad_r1m_perception_video

# Install pixi ROS dependencies (pixi.toml is in the package)
RUN cd /ros2_ws/src/ad_r1m_perception_video && pixi install

# Download FastSAM model
RUN cd /ros2_ws/src/ad_r1m_perception_video && \
    python3 -m ad_r1m_perception_video.utils.pull_model

RUN pip3 install onnx pyzmq

WORKDIR /ros2_ws/src/ad_r1m_perception_video

ENV DEBIAN_FRONTEND=

CMD ["bash"]
